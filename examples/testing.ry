# Tests live next to the code.
# Run them with:  rythme test testing.ry

fn double(x) = x * 2

fn clamp(x, low, high) = max(low, min(x, high))

test "double of 2 is 4" = assert_eq(double(2), 4)

test "double keeps the sign"
  assert(double(-3) < 0, "should stay negative")
  assert_eq(double(0), 0)
end

test "clamp stays in bounds"
  assert_eq(clamp(15, 0, 10), 10)
  assert_eq(clamp(-5, 0, 10), 0)
  assert_eq(clamp(5, 0, 10), 5)
end

# This line is skipped while testing.
print(double(21))
