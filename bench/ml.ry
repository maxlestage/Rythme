# Machine learning: products of 100×100 matrices, and a training loop of
# logistic regression by gradient descent on 200 points (vectors, `dot`,
# `sigmoid`, `vector_sub`, `vector_scale`, `matmul` on every step).

fn matrix(n, seed) = 0..n - 1 |> map(fn(r) = 0..n - 1 |> map(fn(c) = ((r * 31 + c * 17 + seed) % 97) / 97))

a = matrix(100, 1)
b = matrix(100, 2)
powers = 1..20 |> fold(a, fn(m, _) = map(matmul(m, b), fn(row) = vector_scale(row, 1 / 50)))

# Points [x, y, 1] (the 1 for the bias), labelled 1 above the line y = 1 - x.
points = 0..199 |> map(fn(i) = [(i * 37 % 100) / 100, (i * 61 % 100) / 100, 1])
labels = map(points, fn([x, y, _]) = if y > 1 - x then 1 else 0)

## One step of gradient descent on the log loss, for all the points at once.
fn learn(weights, _)
  predictions = map(matmul(points, weights), sigmoid)
  errors = vector_sub(predictions, labels)
  vector_sub(weights, vector_scale(matmul(transpose(points), errors), 0.5 / len(points)))
end

weights = fold(1..300, [0, 0, 0], learn)
right = count(zip(points, labels), fn([p, l]) = (if dot(weights, p) > 0 then 1 else 0) == l)

print(round(sum(map(powers, sum)), 6), map(weights, fn(w) = round(w, 4)), right)
