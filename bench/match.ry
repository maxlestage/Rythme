# `match` on the constructors of a type, and on Option.

type Shape = Circle(r) | Rect(w, h) | Tri(a, b, c) | Dot

fn make(i) = match i % 4
  0 -> Circle(i % 10)
  1 -> Rect(i % 7, i % 5)
  2 -> Tri(1, i % 3, 2)
  _ -> Dot
end

fn area(shape) = match shape
  Circle(r) -> 3 * r * r
  Rect(w, h) -> w * h
  Tri(a, b, c) -> a + b + c
  Dot -> 0
end

fn half(n) = if n % 2 == 0 then Some(n // 2) else None

fn go(0, acc) = acc
fn go(n, acc)
  bonus = match half(n)
    Some(h) -> h % 3
    None -> 1
  end
  go(n - 1, acc + area(make(n)) + bonus)
end

print(go(1_000_000, 0))
