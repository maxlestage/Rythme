{
  "name": "rythme",
  "displayName": "Rythme",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "rythme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxlestage/Rythme"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": ["Programming Languages", "Snippets", "Linters", "Debuggers"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:rythme", "onDebugResolve:rythme", "onDebugInitialConfigurations"],
  "contributes": {
    "languages": [
      {
        "id": "rythme",
        "aliases": ["Rythme", "rythme"],
        "extensions": [".ry"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rythme",
        "scopeName": "source.rythme",
        "path": "./syntaxes/rythme.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rythme",
        "path": "./snippets/rythme.json"
      }
    ],
    "breakpoints": [{ "language": "rythme" }],
    "debuggers": [
      {
        "type": "rythme",
        "label": "Rythme",
        "languages": ["rythme"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "%debug.program%", "default": "${file}" },
              "args": { "type": "array", "items": { "type": "string" }, "description": "%debug.args%", "default": [] },
              "stopOnEntry": { "type": "boolean", "description": "%debug.stopOnEntry%", "default": false },
              "cwd": { "type": "string", "description": "%debug.cwd%", "default": "${fileDirname}" }
            }
          }
        },
        "initialConfigurations": [
          { "type": "rythme", "request": "launch", "name": "%debug.name%", "program": "${file}", "cwd": "${fileDirname}" }
        ],
        "configurationSnippets": [
          {
            "label": "%debug.snippet%",
            "description": "%debug.snippet.description%",
            "body": { "type": "rythme", "request": "launch", "name": "%debug.name%", "program": "^\"\\${file}\"", "cwd": "^\"\\${fileDirname}\"" }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Rythme",
      "properties": {
        "rythme.path": {
          "type": "string",
          "default": "rythme",
          "markdownDescription": "%config.path%"
        },
        "rythme.language": {
          "type": "string",
          "enum": ["auto", "en", "fr", "es", "de", "pt", "zh"],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.fr%",
            "%config.language.es%",
            "%config.language.de%",
            "%config.language.pt%",
            "%config.language.zh%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        },
        "rythme.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "markdownDescription": "%config.trace%"
        }
      }
    },
    "commands": [
      { "command": "rythme.restartServer", "title": "%command.restart%", "category": "Rythme" },
      { "command": "rythme.runFile", "title": "%command.run%", "category": "Rythme", "icon": "$(play)" },
      { "command": "rythme.testFile", "title": "%command.test%", "category": "Rythme", "icon": "$(beaker)" },
      { "command": "rythme.debugFile", "title": "%command.debug%", "category": "Rythme", "icon": "$(debug-alt)" },
      { "command": "rythme.runTest", "title": "%command.runTest%", "category": "Rythme" },
      { "command": "rythme.explainError", "title": "%command.explain%", "category": "Rythme" },
      { "command": "rythme.showHelp", "title": "%command.help%", "category": "Rythme" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "rythme.runFile", "when": "editorLangId == rythme" },
        { "command": "rythme.testFile", "when": "editorLangId == rythme" },
        { "command": "rythme.debugFile", "when": "editorLangId == rythme" },
        { "command": "rythme.runTest", "when": "false" }
      ],
      "editor/title/run": [
        { "command": "rythme.runFile", "when": "resourceLangId == rythme", "group": "navigation@1" },
        { "command": "rythme.testFile", "when": "resourceLangId == rythme", "group": "navigation@2" },
        { "command": "rythme.debugFile", "when": "resourceLangId == rythme", "group": "navigation@3" }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node test/load.js && node test/server.js && node test/debug.js",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
