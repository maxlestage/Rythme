{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rythme",
  "scopeName": "source.rythme",
  "fileTypes": ["ry"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#definitions" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#constructors" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.rythme", "match": "##.*$" },
        { "name": "comment.line.number-sign.rythme", "match": "#.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rythme",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.rythme", "match": "\\\\(n|t|r|0|\\\\|\"|\\{|\\}|u\\{[0-9a-fA-F]+\\})" },
        {
          "name": "meta.interpolation.rythme",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.rythme" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.rythme" } },
          "contentName": "source.rythme",
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.rythme" },
            "2": { "name": "entity.name.function.rythme" }
          }
        },
        {
          "match": "\\b(type)\\s+([\\p{Lu}][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.rythme" },
            "2": { "name": "entity.name.type.rythme" }
          }
        },
        {
          "match": "\\b(test)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.other.test.rythme" } }
        },
        {
          "match": "\\b(use)\\b",
          "captures": { "1": { "name": "keyword.control.import.rythme" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.rythme", "match": "\\b(if|then|else|match|end|do)\\b" },
        { "name": "keyword.declaration.function.rythme", "match": "\\bfn\\b" },
        { "name": "keyword.operator.word.rythme", "match": "\\b(and|or|not)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.rythme", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.rythme", "match": "\\b(None|pi)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.rythme", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.rythme", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.float.rythme", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b" },
        { "name": "constant.numeric.float.rythme", "match": "\\b\\d[\\d_]*[eE][+-]?\\d+\\b" },
        { "name": "constant.numeric.integer.rythme", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "constructors": {
      "name": "entity.name.type.constructor.rythme",
      "match": "\\b\\p{Lu}[\\p{L}\\p{N}_]*\\b"
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.rythme",
          "match": "\\b(print|debug|text|input|type_of|help|assert|assert_eq|fail|args|exit|time|random|abs|min|max|sqrt|pow|floor|ceil|round|int|float|sin|cos|tan|log|exp|is_even|is_odd|len|upper|lower|trim|split|join|contains|starts_with|ends_with|replace|chars|lines|repeat|parse_int|parse_float|map|filter|fold|each|sum|product|first|last|rest|get|push|reverse|sort|sort_by|unique|slice|take|drop|zip|enumerate|any|all|find|count|index_of|flatten|flat_map|partition|group_by|is_empty|keys|values|entries|has|put|remove|unwrap|unwrap_or|is_some|is_none|is_ok|is_err|read_file|write_file|file_exists)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.rythme",
          "match": "\\b[\\p{Ll}_][\\p{L}\\p{N}_]*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.pipe.rythme", "match": "\\|>" },
        { "name": "keyword.operator.arrow.rythme", "match": "->" },
        { "name": "keyword.operator.range.rythme", "match": "\\.\\." },
        { "name": "keyword.operator.try.rythme", "match": "\\?" },
        { "name": "keyword.operator.comparison.rythme", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.rythme", "match": "\\*\\*|//|[+\\-*/%]" },
        { "name": "keyword.operator.assignment.rythme", "match": "=" },
        { "name": "keyword.operator.pattern.rythme", "match": "\\|" }
      ]
    }
  }
}
