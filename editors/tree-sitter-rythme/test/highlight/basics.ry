## Squares a number.
# <- comment.documentation
fn square(x) = x * x
# <- keyword.function
#  ^ function
#         ^ variable.parameter
#                ^ operator

type Shape = Circle(radius) | Square(side)
# <- keyword.type
#    ^ type.definition
#            ^ constructor

fn area(shape) = match shape
#                ^ keyword.conditional
  Circle(r) -> 3.14 * r * r
# ^ constructor
#           ^ operator
#              ^ number.float
  Square(s) -> s ** 2
#                   ^ number
end
# <- keyword

point = {x: 1, type: "point"}
#        ^ property
#              ^ property
#                    ^ string
print("{point.x} and {len([1, 2])}")
# <- function.call
#      ^ punctuation.special
