{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rythme",
      "camelcase": "Rythme",
      "title": "Rythme",
      "scope": "source.rythme",
      "file-types": ["ry"],
      "injection-regex": "^(rythme|ry)$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "indents": "queries/indents.scm"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Rythme grammar for Tree-sitter",
    "links": {
      "repository": "https://github.com/maxlestage/Rythme"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
