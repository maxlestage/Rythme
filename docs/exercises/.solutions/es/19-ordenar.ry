# Ejercicio 19 · Ordenar  ★★★
# Solución de referencia. ¡Intenta hacer el ejercicio antes de leerla!

fn insertar([], x) = [x]
fn insertar([primero, ..resto], x) = if x <= primero then [x, primero, ..resto] else [primero, ..insertar(resto, x)]

fn ordenar_por_insercion(lista) = fold(lista, [], insertar)

fn mezclar([], b) = b
fn mezclar(a, []) = a
fn mezclar([x, ..xs], [y, ..ys]) = if x <= y then [x, ..mezclar(xs, [y, ..ys])] else [y, ..mezclar([x, ..xs], ys)]

fn ordenar_por_mezcla(lista) if len(lista) <= 1 = lista
fn ordenar_por_mezcla(lista)
  mitad = len(lista) // 2
  mezclar(ordenar_por_mezcla(take(lista, mitad)), ordenar_por_mezcla(drop(lista, mitad)))
end

# --- Pruebas (no las cambies) ---

test "insertar"
  assert_eq(insertar([1, 3, 5], 4), [1, 3, 4, 5])
  assert_eq(insertar([], 2), [2])
  assert_eq(insertar([1, 2], 9), [1, 2, 9])
end

test "ordenar por inserción"
  assert_eq(ordenar_por_insercion([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(ordenar_por_insercion([]), [])
end

test "mezclar"
  assert_eq(mezclar([1, 4, 6], [2, 3, 7]), [1, 2, 3, 4, 6, 7])
  assert_eq(mezclar([], [1]), [1])
  assert_eq(mezclar([1], []), [1])
end

test "ordenar por mezcla"
  assert_eq(ordenar_por_mezcla([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(ordenar_por_mezcla(["pera", "manzana", "higo"]), ["higo", "manzana", "pera"])
  assert_eq(ordenar_por_mezcla(reverse(1..100)), 1..100)
end
