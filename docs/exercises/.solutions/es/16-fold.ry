# Ejercicio 16 · Plegar una lista en un solo valor  ★★☆
# Solución de referencia. ¡Intenta hacer el ejercicio antes de leerla!

fn producto_de(lista) = fold(lista, 1, fn(resultado, x) = resultado * x)

fn palabra_mas_larga(palabras) = fold(palabras, "", fn(mejor, p) = if len(p) > len(mejor) then p else mejor)

fn a_numero(cifras) = fold(cifras, 0, fn(n, c) = n * 10 + c)

fn contar_si(lista, f) = fold(lista, 0, fn(n, x) = if f(x) then n + 1 else n)

# --- Pruebas (no las cambies) ---

test "producto"
  assert_eq(producto_de([2, 3, 4]), 24)
  assert_eq(producto_de([]), 1)
end

test "palabra más larga"
  assert_eq(palabra_mas_larga(["el", "árbol", "es", "verde"]), "árbol")
  assert_eq(palabra_mas_larga(["uno", "dos"]), "uno")
  assert_eq(palabra_mas_larga([]), "")
end

test "a número"
  assert_eq(a_numero([1, 2, 3]), 123)
  assert_eq(a_numero([0, 7]), 7)
  assert_eq(a_numero([]), 0)
end

test "contar si"
  assert_eq(contar_si([1, 2, 3, 4, 5], is_odd), 3)
  assert_eq(contar_si(["a", "bb"], fn(p) = len(p) > 5), 0)
end
