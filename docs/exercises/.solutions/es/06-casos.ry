# Ejercicio 06 · Una definición por caso  ★☆☆
# Solución de referencia. ¡Intenta hacer el ejercicio antes de leerla!

fn plural(1, palabra) = "1 {palabra}"
fn plural(n, palabra) = "{n} {palabra}s"

fn fizzbuzz(n) if n % 15 == 0 = "FizzBuzz"
fn fizzbuzz(n) if n % 3 == 0 = "Fizz"
fn fizzbuzz(n) if n % 5 == 0 = "Buzz"
fn fizzbuzz(n) = text(n)

fn tipo_de_dia("sábado") = "fin de semana"
fn tipo_de_dia("domingo") = "fin de semana"
fn tipo_de_dia(_) = "entre semana"

# --- Pruebas (no las cambies) ---

test "plural"
  assert_eq(plural(1, "gato"), "1 gato")
  assert_eq(plural(2, "gato"), "2 gatos")
  assert_eq(plural(0, "perro"), "0 perros")
end

test "fizzbuzz"
  assert_eq(fizzbuzz(1), "1")
  assert_eq(fizzbuzz(3), "Fizz")
  assert_eq(fizzbuzz(10), "Buzz")
  assert_eq(fizzbuzz(30), "FizzBuzz")
  assert_eq(fizzbuzz(31), "31")
end

test "los quince primeros" = assert_eq(1..15 |> map(fizzbuzz) |> join(" "), "1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 FizzBuzz")

test "tipo de día"
  assert_eq(tipo_de_dia("sábado"), "fin de semana")
  assert_eq(tipo_de_dia("domingo"), "fin de semana")
  assert_eq(tipo_de_dia("lunes"), "entre semana")
end
