# Ejercicio 36 · Jugar perfectamente: el minimax  ★★★
# Solución de referencia. ¡Intenta hacer el ejercicio antes de leerla!

fn jugadas(n) = filter(1..3, fn(m) = m <= n)

fn gana(n) = any(jugadas(n), fn(m) = not gana(n - m))

fn mejor_jugada(n) = find(jugadas(n), fn(m) = not gana(n - m))

# --- Pruebas (no las cambies) ---

test "jugadas"
  assert_eq(jugadas(10), [1, 2, 3])
  assert_eq(jugadas(2), [1, 2])
  assert_eq(jugadas(0), [])
end

test "quién gana"
  assert_eq(map(0..8, gana), [false, true, true, true, false, true, true, true, false])
end

test "mejor jugada"
  assert_eq(mejor_jugada(5), Some(1))
  assert_eq(mejor_jugada(7), Some(3))
  assert_eq(mejor_jugada(8), None)
end
