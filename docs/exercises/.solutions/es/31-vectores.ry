# Ejercicio 31 · Puntos como vectores  ★☆☆
# Solución de referencia. ¡Intenta hacer el ejercicio antes de leerla!

fn distance(a, b) = norm(vector_sub(a, b))

fn punto_medio(a, b) = vector_scale(vector_add(a, b), 0.5)

fn el_mas_cercano(puntos, p) = min_by(puntos, fn(q) = distance(q, p))

# --- Pruebas (no las cambies) ---

test "distancia"
  assert_eq(distance([0, 0], [3, 4]), 5.0)
  assert_eq(distance([1, 1, 1], [1, 1, 1]), 0.0)
end

test "punto medio"
  assert_eq(punto_medio([0, 0], [4, 2]), [2.0, 1.0])
  assert_eq(punto_medio([-1, 3], [1, 3]), [0.0, 3.0])
end

test "el más cercano"
  assert_eq(el_mas_cercano([[0, 0], [5, 5], [9, 1]], [6, 4]), [5, 5])
  assert_eq(el_mas_cercano([[2, 2]], [100, -100]), [2, 2])
end
