# Ejercicio 07 · Recursión  ★★☆
# Solución de referencia. ¡Intenta hacer el ejercicio antes de leerla!

fn factorial(0) = 1
fn factorial(n) = n * factorial(n - 1)

fn suma_hasta(0) = 0
fn suma_hasta(n) = n + suma_hasta(n - 1)

fn potencia(_, 0) = 1
fn potencia(x, n) = x * potencia(x, n - 1)

# --- Pruebas (no las cambies) ---

test "factorial"
  assert_eq(factorial(0), 1)
  assert_eq(factorial(1), 1)
  assert_eq(factorial(5), 120)
  assert_eq(factorial(10), 3628800)
end

test "suma hasta"
  assert_eq(suma_hasta(0), 0)
  assert_eq(suma_hasta(1), 1)
  assert_eq(suma_hasta(10), 55)
  assert_eq(suma_hasta(100), 5050)
end

test "potencia"
  assert_eq(potencia(2, 0), 1)
  assert_eq(potencia(2, 10), 1024)
  assert_eq(potencia(3, 4), 81)
  assert_eq(potencia(1.5, 2), 2.25)
end
