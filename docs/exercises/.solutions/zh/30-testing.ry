# 练习 30 · 测试能发现错误  ★★★
# 参考答案。请先自己做这个练习，再来看它！

fn clamp(x, low, high) = max(low, min(x, high))

fn median(list)
  sorted = sort(list)
  middle = len(sorted) // 2
  if is_even(len(sorted)) then (sorted[middle - 1] + sorted[middle]) / 2 else sorted[middle]
end

fn count_words(text) = len(split(text))

# --- 测试（请不要修改）---

test "限制范围"
  assert_eq(clamp(15, 0, 10), 10)
  assert_eq(clamp(-5, 0, 10), 0)
  assert_eq(clamp(5, 0, 10), 5)
end

test "奇数个值的中位数"
  assert_eq(median([1, 2, 3]), 2)
  assert_eq(median([3, 1, 2]), 2)
end

test "偶数个值的中位数" = assert_eq(median([4, 1, 3, 2]), 2.5)

test "统计单词"
  assert_eq(count_words("one two three"), 3)
  assert_eq(count_words("  one   two "), 2)
end

# 你的测试：
test "限制到同一个值" = assert_eq(clamp(5, 5, 5), 5)
