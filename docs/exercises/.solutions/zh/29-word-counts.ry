# 练习 29 · 一个小项目：统计单词  ★★★
# 参考答案。请先自己做这个练习，再来看它！

fn words_of(text) = [".", ",", "!", "?"] |> fold(text, fn(t, mark) = replace(t, mark, " ")) |> lower |> split

fn frequencies(text) =
  words_of(text)
    |> group_by(fn(w) = w)
    |> entries
    |> map(fn([word, list]) = [word, len(list)])
    |> sort_by(fn([word, _]) = word)
    |> sort_by(fn([_, n]) = -n)

fn most_frequent(text) = frequencies(text) |> first |> map(fn([word, _]) = word)

fn report(text, n) = frequencies(text) |> take(n) |> map(fn([word, count]) = "{word}: {count}") |> join("\n")

# --- 测试（请不要修改）---

poem = "The cat sat. The dog sat! Did the cat see the dog?"

test "单词" = assert_eq(words_of("Hello, World! Hello?"), ["hello", "world", "hello"])

test "频率"
  assert_eq(frequencies("b a b c a b"), [["b", 3], ["a", 2], ["c", 1]])
  assert_eq(frequencies(poem) |> take(3), [["the", 4], ["cat", 2], ["dog", 2]])
end

test "最常见的单词"
  assert_eq(most_frequent(poem), Some("the"))
  assert_eq(most_frequent(" ... "), None)
end

test "报告" = assert_eq(report(poem, 3), "the: 4\ncat: 2\ndog: 2")
