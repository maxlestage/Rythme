# Exercise 06 · One definition per case  ★☆☆
# Reference solution. Try the exercise before reading it!

fn plural(1, word) = "1 {word}"
fn plural(n, word) = "{n} {word}s"

fn fizzbuzz(n) if n % 15 == 0 = "FizzBuzz"
fn fizzbuzz(n) if n % 3 == 0 = "Fizz"
fn fizzbuzz(n) if n % 5 == 0 = "Buzz"
fn fizzbuzz(n) = text(n)

fn day_kind("Saturday") = "weekend"
fn day_kind("Sunday") = "weekend"
fn day_kind(_) = "weekday"

# --- Tests (do not change them) ---

test "plural"
  assert_eq(plural(1, "cat"), "1 cat")
  assert_eq(plural(2, "cat"), "2 cats")
  assert_eq(plural(0, "dog"), "0 dogs")
end

test "fizzbuzz"
  assert_eq(fizzbuzz(1), "1")
  assert_eq(fizzbuzz(3), "Fizz")
  assert_eq(fizzbuzz(10), "Buzz")
  assert_eq(fizzbuzz(30), "FizzBuzz")
  assert_eq(fizzbuzz(31), "31")
end

test "the first fifteen" = assert_eq(1..15 |> map(fizzbuzz) |> join(" "), "1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 FizzBuzz")

test "day kind"
  assert_eq(day_kind("Saturday"), "weekend")
  assert_eq(day_kind("Sunday"), "weekend")
  assert_eq(day_kind("Monday"), "weekday")
end
