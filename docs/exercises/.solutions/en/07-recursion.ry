# Exercise 07 · Recursion  ★★☆
# Reference solution. Try the exercise before reading it!

fn factorial(0) = 1
fn factorial(n) = n * factorial(n - 1)

fn sum_to(0) = 0
fn sum_to(n) = n + sum_to(n - 1)

fn power(_, 0) = 1
fn power(x, n) = x * power(x, n - 1)

# --- Tests (do not change them) ---

test "factorial"
  assert_eq(factorial(0), 1)
  assert_eq(factorial(1), 1)
  assert_eq(factorial(5), 120)
  assert_eq(factorial(10), 3628800)
end

test "sum to"
  assert_eq(sum_to(0), 0)
  assert_eq(sum_to(1), 1)
  assert_eq(sum_to(10), 55)
  assert_eq(sum_to(100), 5050)
end

test "power"
  assert_eq(power(2, 0), 1)
  assert_eq(power(2, 10), 1024)
  assert_eq(power(3, 4), 81)
  assert_eq(power(1.5, 2), 2.25)
end
