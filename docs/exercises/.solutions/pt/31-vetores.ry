# Exercício 31 · Pontos como vetores  ★☆☆
# Solução de referência. Tente fazer o exercício antes de lê-la!

fn distancia(a, b) = norm(vector_sub(a, b))

fn ponto_medio(a, b) = vector_scale(vector_add(a, b), 0.5)

fn o_mais_proximo(pontos, p) = min_by(pontos, fn(q) = distancia(q, p))

# --- Testes (não os altere) ---

test "distância"
  assert_eq(distancia([0, 0], [3, 4]), 5.0)
  assert_eq(distancia([1, 1, 1], [1, 1, 1]), 0.0)
end

test "ponto médio"
  assert_eq(ponto_medio([0, 0], [4, 2]), [2.0, 1.0])
  assert_eq(ponto_medio([-1, 3], [1, 3]), [0.0, 3.0])
end

test "o mais próximo"
  assert_eq(o_mais_proximo([[0, 0], [5, 5], [9, 1]], [6, 4]), [5, 5])
  assert_eq(o_mais_proximo([[2, 2]], [100, -100]), [2, 2])
end
