# Exercício 33 · Um neurônio artificial  ★★☆
# Solução de referência. Tente fazer o exercício antes de lê-la!

fn neuronio(pesos, vies, entradas) = sigmoid(dot(pesos, entradas) + vies)

fn dispara(pesos, vies, entradas) = neuronio(pesos, vies, entradas) >= 0.5

fn camada(matriz, vieses, entradas) = map(vector_add(matmul(matriz, entradas), vieses), sigmoid)

# --- Testes (não os altere) ---

test "neurônio"
  assert_eq(neuronio([1, -1], 0, [2, 2]), 0.5)
  assert_eq(round(neuronio([2, 1], -1, [1, 1]), 3), 0.881)
end

test "um neurônio que calcula E"
  assert(dispara([10, 10], -15, [1, 1]))
  assert(not dispara([10, 10], -15, [1, 0]))
  assert(not dispara([10, 10], -15, [0, 0]))
end

test "camada"
  saidas = camada([[1, -1], [1, 1]], [0, 1], [2, 2])
  assert_eq(map(saidas, fn(x) = round(x, 3)), [0.5, 0.993])
end
