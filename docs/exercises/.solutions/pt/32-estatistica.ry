# Exercício 32 · Estatística sobre dados  ★★☆
# Solução de referência. Tente fazer o exercício antes de lê-la!

fn padronizar(xs)
  s = stats(xs)
  map(xs, fn(x) = (x - s.mean) / s.std_dev)
end

fn atipicos(xs)
  s = stats(xs)
  filter(xs, fn(x) = abs(x - s.mean) > 2 * s.std_dev)
end

fn acuracia(previsoes, respostas) = count(zip(previsoes, respostas), fn([p, a]) = p == a) / len(respostas)

# --- Testes (não os altere) ---

test "padronizar"
  assert_eq(padronizar([2, 4, 4, 4, 5, 5, 7, 9]), [-1.5, -0.5, -0.5, -0.5, 0.0, 0.0, 1.0, 2.0])
end

test "valores atípicos"
  assert_eq(atipicos([10, 11, 9, 10, 10, 12, 10, 9, 11, 10, 50]), [50])
  assert_eq(atipicos([1, 2, 3]), [])
end

test "acurácia"
  assert_eq(acuracia(["gato", "cachorro", "gato", "gato"], ["gato", "cachorro", "cachorro", "gato"]), 0.75)
  assert_eq(acuracia([1, 0], [0, 1]), 0.0)
end
