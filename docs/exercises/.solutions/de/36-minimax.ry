# Übung 36 · Perfekt spielen: Minimax  ★★★
# Musterlösung. Versuche dich zuerst selbst an der Übung!

fn zuege(n) = filter(1..3, fn(m) = m <= n)

fn gewinnt(n) = any(zuege(n), fn(m) = not gewinnt(n - m))

fn bester_zug(n) = find(zuege(n), fn(m) = not gewinnt(n - m))

# --- Tests (nicht verändern) ---

test "Züge"
  assert_eq(zuege(10), [1, 2, 3])
  assert_eq(zuege(2), [1, 2])
  assert_eq(zuege(0), [])
end

test "wer gewinnt"
  assert_eq(map(0..8, gewinnt), [false, true, true, true, false, true, true, true, false])
end

test "bester Zug"
  assert_eq(bester_zug(5), Some(1))
  assert_eq(bester_zug(7), Some(3))
  assert_eq(bester_zug(8), None)
end
