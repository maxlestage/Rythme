# Übung 31 · Punkte als Vektoren  ★☆☆
# Musterlösung. Versuche dich zuerst selbst an der Übung!

fn abstand(a, b) = norm(vector_sub(a, b))

fn mittelpunkt(a, b) = vector_scale(vector_add(a, b), 0.5)

fn naechster(punkte, p) = min_by(punkte, fn(q) = abstand(q, p))

# --- Tests (nicht verändern) ---

test "Abstand"
  assert_eq(abstand([0, 0], [3, 4]), 5.0)
  assert_eq(abstand([1, 1, 1], [1, 1, 1]), 0.0)
end

test "Mittelpunkt"
  assert_eq(mittelpunkt([0, 0], [4, 2]), [2.0, 1.0])
  assert_eq(mittelpunkt([-1, 3], [1, 3]), [0.0, 3.0])
end

test "der nächste"
  assert_eq(naechster([[0, 0], [5, 5], [9, 1]], [6, 4]), [5, 5])
  assert_eq(naechster([[2, 2]], [100, -100]), [2, 2])
end
