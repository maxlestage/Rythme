# Übung 29 · Ein kleines Projekt: Wörter zählen  ★★★
# Musterlösung. Versuche dich zuerst selbst an der Übung!

fn woerter_von(text) = [".", ",", "!", "?"] |> fold(text, fn(t, zeichen) = replace(t, zeichen, " ")) |> lower |> split

fn haeufigkeiten(text) =
  woerter_von(text)
    |> group_by(fn(w) = w)
    |> entries
    |> map(fn([wort, liste]) = [wort, len(liste)])
    |> sort_by(fn([wort, _]) = wort)
    |> sort_by(fn([_, n]) = -n)

fn haeufigstes(text) = haeufigkeiten(text) |> first |> map(fn([wort, _]) = wort)

fn bericht(text, n) = haeufigkeiten(text) |> take(n) |> map(fn([wort, anzahl]) = "{wort}: {anzahl}") |> join("\n")

# --- Tests (nicht verändern) ---

gedicht = "Die Katze sah den Hund. Der Hund sah die Katze! Sah die Katze den Hund?"

test "Wörter" = assert_eq(woerter_von("Hallo, Welt! Hallo?"), ["hallo", "welt", "hallo"])

test "Häufigkeiten"
  assert_eq(haeufigkeiten("b a b c a b"), [["b", 3], ["a", 2], ["c", 1]])
  assert_eq(haeufigkeiten(gedicht) |> take(3), [["die", 3], ["hund", 3], ["katze", 3]])
end

test "das häufigste"
  assert_eq(haeufigstes(gedicht), Some("die"))
  assert_eq(haeufigstes(" ... "), None)
end

test "Bericht" = assert_eq(bericht(gedicht, 3), "die: 3\nhund: 3\nkatze: 3")
