# Exercice 02 · Textes  ★☆☆
# Solution de référence. Essayez l'exercice avant de la lire !

## Une salutation pour `nom`.
fn saluer(nom) = "Bonjour, {nom} !"

## Le texte en majuscules, suivi de " !".
fn crier(texte) = upper(texte) + " !"

## Les initiales d'une personne, chacune suivie d'un point.
fn initiales(prenom, nom) = "{prenom[0]}.{nom[0]}."

## Une phrase qui présente une personne.
fn presenter(nom, age) = "{nom} a {age} ans."

# --- Tests (ne les modifiez pas) ---

test "saluer" = assert_eq(saluer("Ada"), "Bonjour, Ada !")

test "saluer quelqu'un d'autre" = assert_eq(saluer("Alan"), "Bonjour, Alan !")

test "crier"
  assert_eq(crier("bonjour"), "BONJOUR !")
  assert_eq(crier("Stop"), "STOP !")
end

test "initiales"
  assert_eq(initiales("Ada", "Lovelace"), "A.L.")
  assert_eq(initiales("grace", "hopper"), "g.h.")
end

test "présenter" = assert_eq(presenter("Ada", 36), "Ada a 36 ans.")
