# Exercice 19 · Trier  ★★★
# Solution de référence. Essayez l'exercice avant de la lire !

fn inserer([], x) = [x]
fn inserer([premier, ..reste], x) = if x <= premier then [x, premier, ..reste] else [premier, ..inserer(reste, x)]

fn tri_par_insertion(liste) = fold(liste, [], inserer)

fn fusionner([], b) = b
fn fusionner(a, []) = a
fn fusionner([x, ..xs], [y, ..ys]) = if x <= y then [x, ..fusionner(xs, [y, ..ys])] else [y, ..fusionner([x, ..xs], ys)]

fn tri_fusion(liste) if len(liste) <= 1 = liste
fn tri_fusion(liste)
  moitie = len(liste) // 2
  fusionner(tri_fusion(take(liste, moitie)), tri_fusion(drop(liste, moitie)))
end

# --- Tests (ne les modifiez pas) ---

test "insérer"
  assert_eq(inserer([1, 3, 5], 4), [1, 3, 4, 5])
  assert_eq(inserer([], 2), [2])
  assert_eq(inserer([1, 2], 9), [1, 2, 9])
end

test "tri par insertion"
  assert_eq(tri_par_insertion([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(tri_par_insertion([]), [])
end

test "fusionner"
  assert_eq(fusionner([1, 4, 6], [2, 3, 7]), [1, 2, 3, 4, 6, 7])
  assert_eq(fusionner([], [1]), [1])
  assert_eq(fusionner([1], []), [1])
end

test "tri fusion"
  assert_eq(tri_fusion([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(tri_fusion(["poire", "abricot", "figue"]), ["abricot", "figue", "poire"])
  assert_eq(tri_fusion(reverse(1..100)), 1..100)
end
