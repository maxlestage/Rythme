# 練習問題 24 · 木  ★★★
# 参考解答。読む前に、まず自分で練習問題に挑戦してください！

type Tree = Leaf | Node(left, value, right)

fn size(Leaf) = 0
fn size(Node(left, _, right)) = size(left) + 1 + size(right)

fn total(Leaf) = 0
fn total(Node(left, value, right)) = total(left) + value + total(right)

fn depth(Leaf) = 0
fn depth(Node(left, _, right)) = 1 + max(depth(left), depth(right))

fn insert(Leaf, x) = Node(Leaf, x, Leaf)
fn insert(Node(left, value, right), x) =
  if x < value then Node(insert(left, x), value, right) else Node(left, value, insert(right, x))

fn to_list(Leaf) = []
fn to_list(Node(left, value, right)) = to_list(left) + [value] + to_list(right)

# --- テスト（変更しないでください）---

#       5
#      / \
#     3   8
#    /
#   1
small = Node(Node(Node(Leaf, 1, Leaf), 3, Leaf), 5, Node(Leaf, 8, Leaf))

test "大きさ"
  assert_eq(size(Leaf), 0)
  assert_eq(size(small), 4)
end

test "合計" = assert_eq(total(small), 17)

test "深さ"
  assert_eq(depth(Leaf), 0)
  assert_eq(depth(small), 3)
end

test "挿入"
  assert_eq(insert(Leaf, 4), Node(Leaf, 4, Leaf))
  assert_eq(insert(Node(Leaf, 4, Leaf), 2), Node(Node(Leaf, 2, Leaf), 4, Leaf))
end

test "リストにする" = assert_eq(to_list(small), [1, 3, 5, 8])

test "木で並べ替え" = assert_eq([7, 2, 9, 4, 1] |> fold(Leaf, insert) |> to_list, [1, 2, 4, 7, 9])
