# 練習問題 31 · ベクトルとしての点  ★☆☆
# 参考解答。読む前に、まず自分で練習問題に挑戦してください！

fn distance(a, b) = norm(vector_sub(a, b))

fn midpoint(a, b) = vector_scale(vector_add(a, b), 0.5)

fn closest(points, p) = min_by(points, fn(q) = distance(q, p))

# --- テスト（変更しないでください）---

test "距離"
  assert_eq(distance([0, 0], [3, 4]), 5.0)
  assert_eq(distance([1, 1, 1], [1, 1, 1]), 0.0)
end

test "中点"
  assert_eq(midpoint([0, 0], [4, 2]), [2.0, 1.0])
  assert_eq(midpoint([-1, 3], [1, 3]), [0.0, 3.0])
end

test "いちばん近い点"
  assert_eq(closest([[0, 0], [5, 5], [9, 1]], [6, 4]), [5, 5])
  assert_eq(closest([[2, 2]], [100, -100]), [2, 2])
end
