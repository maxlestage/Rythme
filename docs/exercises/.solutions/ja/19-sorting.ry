# 練習問題 19 · 並べ替え  ★★★
# 参考解答。読む前に、まず自分で練習問題に挑戦してください！

fn insert([], x) = [x]
fn insert([first, ..rest], x) = if x <= first then [x, first, ..rest] else [first, ..insert(rest, x)]

fn insertion_sort(list) = fold(list, [], insert)

fn merge([], b) = b
fn merge(a, []) = a
fn merge([x, ..xs], [y, ..ys]) = if x <= y then [x, ..merge(xs, [y, ..ys])] else [y, ..merge([x, ..xs], ys)]

fn merge_sort(list) if len(list) <= 1 = list
fn merge_sort(list)
  half = len(list) // 2
  merge(merge_sort(take(list, half)), merge_sort(drop(list, half)))
end

# --- テスト（変更しないでください）---

test "挿入"
  assert_eq(insert([1, 3, 5], 4), [1, 3, 4, 5])
  assert_eq(insert([], 2), [2])
  assert_eq(insert([1, 2], 9), [1, 2, 9])
end

test "挿入ソート"
  assert_eq(insertion_sort([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(insertion_sort([]), [])
end

test "マージ"
  assert_eq(merge([1, 4, 6], [2, 3, 7]), [1, 2, 3, 4, 6, 7])
  assert_eq(merge([], [1]), [1])
  assert_eq(merge([1], []), [1])
end

test "マージソート"
  assert_eq(merge_sort([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(merge_sort(["pear", "apple", "fig"]), ["apple", "fig", "pear"])
  assert_eq(merge_sort(reverse(1..100)), 1..100)
end
