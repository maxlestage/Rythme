# 練習問題 11 · リストを分解する  ★★☆
# 参考解答。読む前に、まず自分で練習問題に挑戦してください！

fn total([]) = 0
fn total([x, ..rest]) = x + total(rest)

fn largest([]) = fail("リストが空です")
fn largest([x]) = x
fn largest([x, ..rest])
  others = largest(rest)
  if x > others then x else others
end

fn has_value([], _) = false
fn has_value([first, ..rest], x) = first == x or has_value(rest, x)

fn last_one([]) = fail("リストが空です")
fn last_one([x]) = x
fn last_one([_, ..rest]) = last_one(rest)

# --- テスト（変更しないでください）---

test "合計"
  assert_eq(total([]), 0)
  assert_eq(total([4]), 4)
  assert_eq(total([1, 2, 3, 4]), 10)
end

test "いちばん大きい要素"
  assert_eq(largest([7]), 7)
  assert_eq(largest([3, 9, 2]), 9)
  assert_eq(largest([-3, -1, -2]), -1)
end

test "値を含むか"
  assert_eq(has_value([1, 2, 3], 2), true)
  assert_eq(has_value([1, 2, 3], 5), false)
  assert_eq(has_value([], 1), false)
  assert_eq(has_value(["a", "b"], "b"), true)
end

test "最後の要素"
  assert_eq(last_one([1, 2, 3]), 3)
  assert_eq(last_one(["ひとつ"]), "ひとつ")
end
