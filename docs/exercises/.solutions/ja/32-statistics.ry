# 練習問題 32 · データの統計  ★★☆
# 参考解答。読む前に、まず自分で練習問題に挑戦してください！

fn standardize(xs)
  s = stats(xs)
  map(xs, fn(x) = (x - s.mean) / s.std_dev)
end

fn outliers(xs)
  s = stats(xs)
  filter(xs, fn(x) = abs(x - s.mean) > 2 * s.std_dev)
end

fn accuracy(predictions, answers) = count(zip(predictions, answers), fn([p, a]) = p == a) / len(answers)

# --- テスト（変更しないでください）---

test "標準化"
  assert_eq(standardize([2, 4, 4, 4, 5, 5, 7, 9]), [-1.5, -0.5, -0.5, -0.5, 0.0, 0.0, 1.0, 2.0])
end

test "外れ値"
  assert_eq(outliers([10, 11, 9, 10, 10, 12, 10, 9, 11, 10, 50]), [50])
  assert_eq(outliers([1, 2, 3]), [])
end

test "正解率"
  assert_eq(accuracy(["cat", "dog", "cat", "cat"], ["cat", "dog", "dog", "cat"]), 0.75)
  assert_eq(accuracy([1, 0], [0, 1]), 0.0)
end
