# Esercizio 33 · Un neurone artificiale  ★★☆
# Soluzione di riferimento. Prova a fare l'esercizio prima di leggerla!

fn neuron(weights, bias, inputs) = sigmoid(dot(weights, inputs) + bias)

fn fires(weights, bias, inputs) = neuron(weights, bias, inputs) >= 0.5

fn layer(matrix, biases, inputs) = map(vector_add(matmul(matrix, inputs), biases), sigmoid)

# --- Test (non cambiarli) ---

test "neurone"
  assert_eq(neuron([1, -1], 0, [2, 2]), 0.5)
  assert_eq(round(neuron([2, 1], -1, [1, 1]), 3), 0.881)
end

test "un neurone che calcola AND"
  assert(fires([10, 10], -15, [1, 1]))
  assert(not fires([10, 10], -15, [1, 0]))
  assert(not fires([10, 10], -15, [0, 0]))
end

test "strato"
  outputs = layer([[1, -1], [1, 1]], [0, 1], [2, 2])
  assert_eq(map(outputs, fn(x) = round(x, 3)), [0.5, 0.993])
end
