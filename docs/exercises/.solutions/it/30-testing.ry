# Esercizio 30 · I test trovano i bug  ★★★
# Soluzione di riferimento. Prova a fare l'esercizio prima di leggerla!

fn clamp(x, low, high) = max(low, min(x, high))

fn median(list)
  sorted = sort(list)
  middle = len(sorted) // 2
  if is_even(len(sorted)) then (sorted[middle - 1] + sorted[middle]) / 2 else sorted[middle]
end

fn count_words(text) = len(split(text))

# --- Test (non cambiarli) ---

test "clamp"
  assert_eq(clamp(15, 0, 10), 10)
  assert_eq(clamp(-5, 0, 10), 0)
  assert_eq(clamp(5, 0, 10), 5)
end

test "mediana di un numero dispari di valori"
  assert_eq(median([1, 2, 3]), 2)
  assert_eq(median([3, 1, 2]), 2)
end

test "mediana di un numero pari di valori" = assert_eq(median([4, 1, 3, 2]), 2.5)

test "conta le parole"
  assert_eq(count_words("one two three"), 3)
  assert_eq(count_words("  one   two "), 2)
end

# Il tuo test:
test "clamp su un solo valore" = assert_eq(clamp(5, 5, 5), 5)
