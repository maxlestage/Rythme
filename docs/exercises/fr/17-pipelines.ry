# Exercice 17 · Les tuyaux `|>`  ★★☆
#
# `x |> f(a)` veut dire `f(x, a)` : la valeur de gauche devient le premier
# argument. Les étapes se lisent de gauche à droite, dans l'ordre où elles
# ont lieu :
#   [3, 1, 2] |> sort |> map(fn(x) = x * 10)        # [10, 20, 30]
# Une ligne qui commence par `|>` continue la ligne précédente.
#
# Énoncé
#   Écrivez chaque fonction comme un seul tuyau :
#   - `somme_des_carres_impairs(n)` : la somme des carrés des nombres
#     impairs de 1 à n ;
#   - `trois_meilleurs(notes)` : les trois meilleures notes, la meilleure
#     d'abord ;
#   - `crier_les_mots(phrase)` : chaque mot en majuscules, séparés par une
#     espace ("bonjour  monde" donne "BONJOUR MONDE") ;
#   - `sigle(phrase)` : la première lettre de chaque mot, en majuscule
#     ("société nationale des chemins de fer" donne "SNDCDF").
#
# Indices
#   1. `filter`, puis `map`, puis `sum`.
#   2. `sort`, `reverse`, `take(3)`.
#   3. `split(texte)` coupe un texte aux espaces (plusieurs espaces comptent
#      pour une) ; `join(mots, " ")` recolle des mots.
#   4. `mot[0]` est le premier caractère de `mot`.
#
# Vérifiez votre travail :  rythme exercise check 17-pipelines.ry
#                     ou :  rythme test 17-pipelines.ry

fn somme_des_carres_impairs(n) = fail("à faire")

fn trois_meilleurs(notes) = fail("à faire")

fn crier_les_mots(phrase) = fail("à faire")

fn sigle(phrase) = fail("à faire")

# --- Tests (ne les modifiez pas) ---

test "somme des carrés impairs"
  assert_eq(somme_des_carres_impairs(5), 35)
  assert_eq(somme_des_carres_impairs(1), 1)
end

test "trois meilleurs"
  assert_eq(trois_meilleurs([12, 18, 9, 15, 20]), [20, 18, 15])
  assert_eq(trois_meilleurs([4]), [4])
end

test "crier les mots" = assert_eq(crier_les_mots("bonjour  monde"), "BONJOUR MONDE")

test "sigle"
  assert_eq(sigle("société nationale des chemins de fer"), "SNDCDF")
  assert_eq(sigle("Rythme"), "R")
end
