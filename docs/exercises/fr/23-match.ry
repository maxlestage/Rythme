# Exercice 23 · Choisir avec `match`  ★★☆
#
# `match` compare une valeur à des motifs, dans l'ordre, et donne le
# résultat du premier qui convient :
#   fn decrire(n) = match n
#     0 -> "zéro"
#     n if n < 0 -> "négatif"
#     _ -> "positif"
#   end
# Les motifs peuvent être des nombres, des textes, des constructeurs, des
# listes (`[]`, `[x]`, `[x, ..reste]`) ou des enregistrements (`{nom}`).
#
# Énoncé
#   - `feu_suivant(feu)` : le feu qui vient après : Vert, puis Orange, puis
#     Rouge, puis Vert de nouveau ;
#   - `peut_passer(feu)` : vrai seulement pour Vert ;
#   - `decrire(liste)` : "vide" pour [], "un : 7" pour [7],
#     "deux : 1 et 2" pour [1, 2], et "plusieurs, à partir de 5" pour les
#     listes plus longues ;
#   - `salutation(personne)` : pour un enregistrement avec un champ
#     `titre`, "Bonjour, Dr Hopper" ; sinon, avec seulement `nom`,
#     "Bonjour, Grace".
#
# Indices
#   1. Chacun des trois feux est un cas du `match`.
#   2. `[a, b]` accepte les listes d'exactement deux éléments, `[premier, ..]`
#      celles d'au moins un élément : mettez les motifs les plus précis
#      d'abord.
#   3. `{titre, famille}` accepte les enregistrements qui ont au moins ces
#      champs.
#
# Vérifiez votre travail :  rythme exercise check 23-match.ry
#                     ou :  rythme test 23-match.ry

type Feu = Vert | Orange | Rouge

fn feu_suivant(feu) = fail("à faire")

fn peut_passer(feu) = fail("à faire")

fn decrire(liste) = fail("à faire")

fn salutation(personne) = fail("à faire")

# --- Tests (ne les modifiez pas) ---

test "feu suivant"
  assert_eq(feu_suivant(Vert), Orange)
  assert_eq(feu_suivant(Orange), Rouge)
  assert_eq(feu_suivant(Rouge), Vert)
end

test "peut passer"
  assert_eq(peut_passer(Vert), true)
  assert_eq(peut_passer(Orange), false)
  assert_eq(peut_passer(Rouge), false)
end

test "décrire"
  assert_eq(decrire([]), "vide")
  assert_eq(decrire([7]), "un : 7")
  assert_eq(decrire([1, 2]), "deux : 1 et 2")
  assert_eq(decrire([5, 6, 7]), "plusieurs, à partir de 5")
end

test "salutation"
  assert_eq(salutation({titre: "Dr", famille: "Hopper", nom: "Grace"}), "Bonjour, Dr Hopper")
  assert_eq(salutation({nom: "Grace"}), "Bonjour, Grace")
end
