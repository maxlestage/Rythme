# Exercice 19 · Trier  ★★★
#
# Deux façons classiques de trier une liste, écrites avec la récursivité
# (sans la fonction intégrée `sort`).
#
# Énoncé
#   - `inserer(triee, x)` : x placé à sa position dans une liste déjà
#     triée ;
#   - `tri_par_insertion(liste)` : trie la liste en insérant chaque
#     élément, l'un après l'autre, dans une liste triée qui commence vide ;
#   - `fusionner(a, b)` : une liste triée à partir de deux listes triées ;
#   - `tri_fusion(liste)` : coupe la liste en deux moitiés, trie chaque
#     moitié, et les fusionne.
#
# Indices
#   1. `inserer([], x)` vaut `[x]`. Pour `inserer([premier, ..reste], x)` :
#      si x <= premier, x se place devant ; sinon premier reste en tête.
#   2. `tri_par_insertion([x, ..reste])` vaut
#      `inserer(tri_par_insertion(reste), x)` (ou utilisez `fold` avec
#      `inserer`).
#   3. `fusionner` compare les premiers éléments des deux listes : le plus
#      petit vient d'abord, suivi de la fusion de ce qui reste.
#   4. `take(liste, n)` et `drop(liste, n)` donnent les deux moitiés, avec
#      `n = len(liste) // 2`. Une liste de 0 ou 1 élément est déjà triée.
#
# Vérifiez votre travail :  rythme exercise check 19-tris.ry
#                     ou :  rythme test 19-tris.ry

fn inserer(triee, x) = fail("à faire")

fn tri_par_insertion(liste) = fail("à faire")

fn fusionner(a, b) = fail("à faire")

fn tri_fusion(liste) = fail("à faire")

# --- Tests (ne les modifiez pas) ---

test "insérer"
  assert_eq(inserer([1, 3, 5], 4), [1, 3, 4, 5])
  assert_eq(inserer([], 2), [2])
  assert_eq(inserer([1, 2], 9), [1, 2, 9])
end

test "tri par insertion"
  assert_eq(tri_par_insertion([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(tri_par_insertion([]), [])
end

test "fusionner"
  assert_eq(fusionner([1, 4, 6], [2, 3, 7]), [1, 2, 3, 4, 6, 7])
  assert_eq(fusionner([], [1]), [1])
  assert_eq(fusionner([1], []), [1])
end

test "tri fusion"
  assert_eq(tri_fusion([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9])
  assert_eq(tri_fusion(["poire", "abricot", "figue"]), ["abricot", "figue", "poire"])
  assert_eq(tri_fusion(reverse(1..100)), 1..100)
end
