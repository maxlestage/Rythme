# Exercice 36 · Jouer parfaitement : le minimax  ★★★
#
# Une partie de Nim : n allumettes sont sur la table ; chaque joueur à son
# tour en prend 1, 2 ou 3, et celui qui prend la dernière allumette gagne.
# Le minimax décide qui gagne en jouant parfaitement en imaginant tous les
# coups : le joueur qui joue gagne si l'un de ses coups laisse l'autre
# joueur dans une position perdante.
#
# Énoncé
#   - `coups(n)` : les nombres d'allumettes qu'on peut prendre (1, 2 ou 3,
#     mais pas plus que n) ;
#   - `gagne(n)` : true quand le joueur qui joue peut toujours gagner avec n
#     allumettes (quand il n'en reste aucune, le joueur qui joue a déjà
#     perdu) ;
#   - `meilleur_coup(n)` : `Some(m)`, où m est le plus petit coup gagnant,
#     ou `None` quand tous les coups perdent.
#
# Indices
#   1. `filter(1..3, ...)` garde les coups permis.
#   2. `gagne(n)` : y a-t-il un coup (`any`) après lequel l'autre joueur ne
#      gagne pas ?
#   3. `find` donne le premier élément qui convient, sous forme d'Option.
#
# Vérifiez votre travail :  rythme exercise check 36-minimax.ry
#                     ou :  rythme test 36-minimax.ry

fn coups(n) = fail("à faire")

fn gagne(n) = fail("à faire")

fn meilleur_coup(n) = fail("à faire")

# --- Tests (ne les modifiez pas) ---

test "coups"
  assert_eq(coups(10), [1, 2, 3])
  assert_eq(coups(2), [1, 2])
  assert_eq(coups(0), [])
end

test "qui gagne"
  assert_eq(map(0..8, gagne), [false, true, true, true, false, true, true, true, false])
end

test "meilleur coup"
  assert_eq(meilleur_coup(5), Some(1))
  assert_eq(meilleur_coup(7), Some(3))
  assert_eq(meilleur_coup(8), None)
end
