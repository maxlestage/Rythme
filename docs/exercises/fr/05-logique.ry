# Exercice 05 · Vrai ou faux  ★☆☆
#
# Les comparaisons (`==`, `!=`, `<`, `<=`, `>`, `>=`) donnent un Bool :
# `true` (vrai) ou `false` (faux). `and` (et), `or` (ou) et `not` (non)
# combinent des Bools.
#
# Énoncé
#   Chaque fonction donne un Bool, et aucune n'a besoin de `if` :
#   - `est_multiple(n, d)` : n est-il un multiple de d ?
#   - `est_entre(x, bas, haut)` : x est-il entre bas et haut (inclus) ?
#   - `est_bissextile(annee)` : une année est bissextile quand c'est un
#     multiple de 4, sauf les multiples de 100 qui ne sont pas multiples de
#     400 (2000 est bissextile, 1900 ne l'est pas) ;
#   - `ou_exclusif(a, b)` : exactement l'un des deux, a ou b, est-il vrai ?
#
# Indices
#   1. n est un multiple de d quand le reste `n % d` vaut 0.
#   2. `x >= bas and x <= haut`
#   3. Écrivez la règle des années bissextiles avec la première fonction :
#      `est_multiple(annee, 4) and (...)`.
#   4. Deux Bools peuvent aussi se comparer avec `!=`.
#
# Vérifiez votre travail :  rythme exercise check 05-logique.ry
#                     ou :  rythme test 05-logique.ry

fn est_multiple(n, d) = fail("à faire")

fn est_entre(x, bas, haut) = fail("à faire")

fn est_bissextile(annee) = fail("à faire")

fn ou_exclusif(a, b) = fail("à faire")

# --- Tests (ne les modifiez pas) ---

test "multiples"
  assert(est_multiple(12, 3), "12 est un multiple de 3")
  assert(not est_multiple(12, 5), "12 n'est pas un multiple de 5")
  assert(est_multiple(0, 7), "0 est un multiple de tous les nombres")
end

test "entre"
  assert(est_entre(5, 1, 10), "5 est entre 1 et 10")
  assert(est_entre(1, 1, 10), "les bornes sont incluses")
  assert(est_entre(10, 1, 10), "les bornes sont incluses")
  assert(not est_entre(11, 1, 10), "11 est trop grand")
  assert(not est_entre(0, 1, 10), "0 est trop petit")
end

test "années bissextiles"
  assert_eq(est_bissextile(2024), true)
  assert_eq(est_bissextile(2023), false)
  assert_eq(est_bissextile(1900), false)
  assert_eq(est_bissextile(2000), true)
end

test "ou exclusif"
  assert_eq(ou_exclusif(true, false), true)
  assert_eq(ou_exclusif(false, true), true)
  assert_eq(ou_exclusif(true, true), false)
  assert_eq(ou_exclusif(false, false), false)
end
